while True:
    try:
        A = int(input("Введите число:"))
        B = int(input("Введите число B (B > A):"))
        if A >= B:
            print("Ошибка: должно выполняться условие A < B")
            continue
        break
    except ValueError:
        print("Ошибка:нужно ввести числа")
sum = sum(range(A, B + 1))
print(sum)
        
